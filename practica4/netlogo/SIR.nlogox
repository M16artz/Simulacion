    <plot x="410" autoPlotX="false" yMax="100.0" autoPlotY="false" yAxis="individuos" y="680" xMin="0.0" height="200" legend="true" xMax="100.0" yMin="0.0" width="380" xAxis="tiempo" display="Comparacion susceptibles">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="Python" color="-16776961" legend="true">
        <setup></setup>
