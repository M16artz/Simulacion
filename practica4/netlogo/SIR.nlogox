    <plot x="10" autoPlotX="false" yMax="100.0" autoPlotY="false" yAxis="individuos" y="900" xMin="0.0" height="200" legend="true" xMax="100.0" yMin="0.0" width="380" xAxis="tiempo" display="Comparacion recuperados">
      <setup></setup>
